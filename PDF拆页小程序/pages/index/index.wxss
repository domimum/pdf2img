.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  background: #f5f7fa;
}

/* 自定义导航栏：三栏布局，右侧留白避开微信胶囊 */
.nav-bar {
  position: sticky;   /* 上滑时固定在顶部 */
  top: 0;
  z-index: 20;        /* 盖在页码网格之上 */
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  /* 不设 width，用默认 auto + 负 margin 才会真正向两侧撑满通栏；
     若写 width:100% 会被锁死在内容区宽度，右侧会少 56rpx 铺不到白色 */
  /* 总高由行内 style 给出：statusBarH + navBarH */
  margin: 0 -28rpx;      /* 抵消 .page 左右 padding，让导航栏通栏 */
  padding-left: 28rpx;
  padding-right: 28rpx;
  background: #fff;
}
.nav-left {
  width: 120rpx;
  display: flex;
  align-items: center;
  height: 44px;
}
.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: 56rpx;
  line-height: 1;
  color: #1f2329;
  font-weight: 300;
}
.nav-back-hover {
  opacity: .5;
}
.nav-title {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.nav-right {
  width: 120rpx;   /* 与左侧对称，把标题挤到正中，避开右侧胶囊 */
  height: 44px;
}

.header {
  padding: 20rpx 8rpx 28rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
}
.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a9099;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .04);
}
.empty-icon {
  width: 120rpx;
  height: 160rpx;
}
.empty-title {
  margin-top: 36rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}
.empty-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a9099;
  line-height: 1.7;
  text-align: center;
}
.desc-line2 {
  margin-top: 0;
}
.tips {
  margin-top: 40rpx;
  align-self: flex-start;
}
.tip {
  font-size: 24rpx;
  color: #a0a6ae;
  line-height: 2;
}

/* 加载/错误态 */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 60rpx 40rpx;
  border-radius: 28rpx;
  background: #fff;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #dbe8fb;
  border-top-color: #306BFE;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff0ef;
  color: #d54941;
  font-size: 44rpx;
  font-weight: 700;
}
.state-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #646a73;
  text-align: center;
}

/* 按钮 */
/* 按钮 */
.btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1.4;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.btn.primary {
  background: #306BFE;
  color: #fff;
  border: none;
}
.btn.primary.is-disabled {
  background: #306BFE;
  color: #fff;
}
.btn.ghost {
  margin-top: 20rpx;
  background: #fff;
  color: #306BFE;
  border: 2rpx solid #306BFE;
}

/* 文件卡片：点它直接用微信原生打开全文 */
.file-card {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .04);
}
.file-card-hover {
  background: #f0f4ff;
}
.file-info {
  flex: 1;
  min-width: 0;
}
.file-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-all;
}
.file-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a9099;
}
.file-arrow {
  margin-left: 20rpx;
  color: #1f2329;
  font-size: 48rpx;
  line-height: 1;
}

/* 工具栏：上滑置顶 */
.toolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 -28rpx 16rpx;
  padding: 18rpx 36rpx;
  background: #f5f7fa;
}
.sel-info {
  font-size: 28rpx;
  color: #646a73;
}
/* 两个数字同一字号，靠字重/颜色区分 */
.sel-num, .sel-total {
  font-size: 30rpx;
  font-weight: 700;
}
.sel-num {
  color: #306BFE;
}
.sel-total {
  color: #1f2329;
  font-weight: 400;
}
.sel-hint {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #a0a6ae;
  font-weight: 400;
}
.tool-btns {
  display: flex;
  gap: 32rpx;
}
.link {
  color: #306BFE;
  font-size: 26rpx;
}

/* 页码网格：5 列，秒出，点选 */
.grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-auto-rows: min-content;
  gap: 14rpx;
}
.num-card {
  position: relative;
  width: 100%;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #fff;
  border: 1px solid transparent;
  overflow: hidden;
}
.num-card.selected {
  border-color: #306BFE;
  background: #fff;
}
.num-big {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1;
}
.num-card.selected .num-big {
  color: #1f2329;
}
.num-zoom {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx;
  border-radius: 8rpx;
  background: #ffffff;
}
.num-zoom-img {
  width: 26rpx;
  height: 26rpx;
}
/* 选中角标：左上角浅灰圆角块 + 白色对勾 */
.num-check {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f3f3;
}
.num-card.selected .num-check {
  background: #306BFE;
}
.num-check-img {
  width: 22rpx;
  height: 22rpx;
}

/* 三按钮横排 */
.btn-row {
  display: flex;
  gap: 14rpx;
}
.btn.mini {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  height: 80rpx;
  font-size: 26rpx;
  padding: 0;
  line-height: 80rpx;
}
.btn.pdfbtn {
  background: #E14949;   /* 红色 PDF 按钮 */
  color: #fff;
  border: none;
}
.btn.pdfbtn.is-disabled {
  background: #E14949;
  color: #fff;
}
/* 转发按钮：白底 + 蓝描边 + 蓝字 */
.btn.sharebtn {
  background: #fff;
  color: #306BFE;
  border: 2rpx solid #306BFE;
}
.btn.sharebtn.is-disabled {
  background: #fff;
  color: #306BFE;
  border-color: #306BFE;
}
/* 三个按钮禁用态 = 可点击状态整体透明度降到 20%（用 view 模拟按钮，不受微信 button 默认禁用样式干扰） */
.btn.is-disabled {
  opacity: 0.2;
}
/* 页码区域留出底部空间，避免被吸底按钮栏遮住 */
.main {
  padding-bottom: 160rpx;
}
/* 底部按钮栏：固定在屏幕底部 */
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
}
.reset {
  display: block;
  margin: 28rpx auto 0;
  text-align: center;
  color: #8a9099;
}
